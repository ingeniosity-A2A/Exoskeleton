{
  "name": "exoskeleton",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r run build --if-present",
    "typecheck": "pnpm -r exec tsc --noEmit --if-present",
    "benchmark:validate": "node scripts/benchmark-gate.mjs validate",
    "benchmark:gate": "node scripts/benchmark-gate.mjs gate",
    "test": "node --test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
