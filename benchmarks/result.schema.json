{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingeniosity.tech/schemas/benchmark-result.schema.json",
  "title": "Ingeniosity Benchmark Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkId",
    "domain",
    "commit",
    "environment",
    "status",
    "metrics",
    "checks",
    "timestamp"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "benchmarkId": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "code",
        "ui",
        "memory",
        "edge",
        "orchestration"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "pnpmVersion": {
          "type": "string"
        },
        "nodeVersion": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "lowerIsBetter": {
            "type": "boolean"
          },
          "baseline": {
            "type": "number"
          },
          "maxRegressionPercent": {
            "type": "number",
            "minimum": 0
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 1
          },
          "p50": {
            "type": "number"
          },
          "p95": {
            "type": "number"
          },
          "p99": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string"
        },
        "datasetVersion": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
