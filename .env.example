# ============================================================================
# Exoskeleton/.env.example
# ============================================================================
# Copy to `.env` (git-ignored) and fill in locally, or set the same names as
# project secrets / CI secrets. Never commit `.env`.
#
#   cp .env.example .env
#
# compose.yaml interpolates these with `${VAR:?message}`, so `kiri compose up`
# fails closed instead of starting an unauthenticated agent.
# ============================================================================

# GitHub token for the Headless GitHub CLI Agent (gh CLI reads GH_TOKEN).
# Fine-grained token, read-only: Contents, Metadata, Issues, Pull requests.
GH_TOKEN=

# Host-aware routing profile: any | s26_ultra_termux | linux_vps | gpu_compute_node
HOST_PROFILE=any
